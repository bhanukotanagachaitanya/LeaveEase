# LeaveEase Backend Environment Configuration

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/leaveease_db?retryWrites=true&w=majority

# Authentication Security Secret Key
JWT_SECRET=leaveease_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Deployment URL (Vercel)
CLIENT_URL=https://your-leaveease-app.vercel.app
